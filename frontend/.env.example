# ============================================================
# SENTINEL 2.0 — Frontend Environment Configuration Template
# ============================================================
# Copy this file to frontend/.env (or frontend/.env.local) for local dev.
# NEVER commit frontend/.env to version control.
#
# Only variables prefixed with VITE_ are exposed to the browser by Vite.
# DO NOT put server-only secrets (GEMINI_API_KEY, SUPABASE keys,
# JWT_SECRET) here — they belong in backend/.env ONLY.
# ============================================================

# Backend API base URL consumed by the React frontend
# Development (via Vite proxy):  http://localhost:4000/api
# Production (deployed backend): https://your-deployed-backend.onrender.com/api
VITE_API_URL=http://localhost:4000/api
