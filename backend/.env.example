# ============================================================
# SENTINEL 2.0 — Backend Environment Configuration Template
# ============================================================
# Copy this file to backend/.env for local development.
# NEVER commit backend/.env to version control.
# All variables here are SERVER-ONLY. None should be prefixed VITE_.
# ============================================================

# HTTP server port (default: 4000)
PORT=4000

# Runtime environment: development | production | test
NODE_ENV=development

# Allowed frontend origin for CORS
# Development: http://localhost:5173
# Production:  https://your-deployed-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# ──────────────────────────────────────────────────────────
# Storage Driver
# supabase → uses Supabase PostgreSQL (recommended for production)
# local    → JSON file store under backend/data/ (default dev fallback)
# memory   → volatile in-process (set automatically in test mode)
# ──────────────────────────────────────────────────────────
STORAGE_DRIVER=local

# ──────────────────────────────────────────────────────────
# Supabase PostgreSQL — SERVER-ONLY, NEVER expose to browser
# ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ──────────────────────────────────────────────────────────
# Google Gemini — SERVER-ONLY, NEVER expose to browser
# ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Set to true to force deterministic mock agent (ignores GEMINI_API_KEY)
DEMO_MODE=false

# JWT secret (reserved for future auth middleware)
JWT_SECRET=your_strong_random_jwt_secret_here

# ──────────────────────────────────────────────────────────
# Spam & Abuse Prevention (SERVER-ONLY)
# ──────────────────────────────────────────────────────────
# Rate limit window in milliseconds (default: 60000 = 1 minute)
SPAM_RATE_LIMIT_WINDOW_MS=60000

# Maximum requests per agent/session within the rate limit window (default: 100)
SPAM_RATE_LIMIT_MAX_REQUESTS=100

# Rolling burst detection window in milliseconds (default: 5000 = 5 seconds)
SPAM_BURST_WINDOW_MS=5000

# Maximum requests in burst window before flagging burst (default: 15)
SPAM_BURST_MAX_REQUESTS=15

# Duplicate/replay action detection window in milliseconds (default: 30000 = 30 seconds)
SPAM_DUPLICATE_WINDOW_MS=30000
